{
  "name": "@aipermission/mcp",
  "version": "0.2.74",
  "mcpName": "io.github.aipermission/aipermission-mcp",
  "description": "Local-only MCP bridge for the aipermission gateway.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "homepage": "https://github.com/aipermission/aipermission/tree/main/packages/mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aipermission/aipermission.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/aipermission/aipermission/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "aipermission-mcp": "dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "format": "prettier --write \"src/**/*.js\" \"test/**/*.js\" \"scripts/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"test/**/*.js\" \"scripts/**/*.js\"",
    "lint": "eslint src test scripts",
    "prepack": "npm run build",
    "test": "npm run build && node scripts/run-tests.js && node scripts/minimum-runtime.js",
    "test:source-archive": "npm run build && node scripts/run-tests.js --current-only",
    "test:windows-acl": "node scripts/run-windows-acl-tests.js",
    "start": "node dist/cli.js",
    "dev": "node src/cli.js"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.23.4 || ^24.22.1 || >=26.12.1",
      "onFail": "error"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "jsonc-parser": "3.3.1",
    "smol-toml": "1.9.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.9"
  }
}
