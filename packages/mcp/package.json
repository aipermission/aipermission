{
  "name": "@aipermission/mcp",
  "version": "0.2.44",
  "mcpName": "io.github.aipermission/aipermission-mcp",
  "description": "Local-first MCP bridge for the aipermission gateway.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "homepage": "https://github.com/aipermission/aipermission/tree/main/packages/mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aipermission/aipermission.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/aipermission/aipermission/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "aipermission-mcp": "dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "format": "prettier --write \"src/**/*.js\" \"test/**/*.js\" \"scripts/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"test/**/*.js\" \"scripts/**/*.js\"",
    "lint": "eslint src test scripts",
    "prepack": "npm run build",
    "test": "npm run build && node --test test/*.test.js",
    "start": "node dist/cli.js",
    "dev": "node src/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=20.19.0",
      "onFail": "error"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "smol-toml": "1.8.0",
    "yaml": "2.9.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6"
  }
}
