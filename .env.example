AIPERMISSION_FRONTEND_PORT=3210
# Optional frontend build hint for generated MCP client setup. Leave empty to
# use the local UI origin. This is not the MCP process's AIPERMISSION_API_URL.
AIPERMISSION_MCP_API_URL=
# Optional advanced setting.
# Normal users should leave this unset. The gateway auto-generates and stores a
# local vault secret on first start. If set explicitly, use at least 32 random
# characters and keep it private.
# AIPERMISSION_GATEWAY_SECRET=replace-with-at-least-32-random-characters
# Optional. Defaults to the configured frontend port only.
# AIPERMISSION_ALLOWED_ORIGINS=http://localhost:3210,http://127.0.0.1:3210,http://[::1]:3210
