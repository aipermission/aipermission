{
  "path": ["src"],
  "minLines": 10,
  "minTokens": 80,
  "mode": "strict",
  "format": ["javascript", "jsx", "typescript", "tsx"],
  "crossFormats": "js-ts",
  "ignore": [
    "**/*.test.js",
    "**/*.test.jsx",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.component.test.js",
    "**/*.component.test.jsx",
    "src/lib/release.generated.json",
    "src/lib/mcp-client-catalog.js"
  ],
  "reporters": ["console"]
}
