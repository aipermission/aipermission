      "files": {
        "lib/owner.js": "\n        import \"./dependency.js{{suffix}}\";\n        export * from \"/src/lib/dependency.js{{suffix}}\";\n        import(`../test/helper.js{{suffix}}`);\n      ",
        "lib/dependency.js": "export const dependency = true;\n",
        "test/helper.js": "export const helper = true;\n"
      }
    },
    "candidates": {
      "directories": ["connectors/templates"],
      "files": {
        "lib/owner.js": "import \"./dependency?v=1\"; import \"./helpers?worker\";",
        "lib/dependency.js": "import \"./owner.js#module\";",
        "lib/helpers/index.js": "export const helper = true;\n"
      }
    },
    "data": {
      "options": { "importBudget": 1 },
      "directories": ["connectors/templates"],
      "files": {
        "lib/owner.js": "\n        import \"./dependency.js{{suffix}}\";\n        export * from \"/src/test/helper.js{{suffix}}\";\n        import(`../../outside.js{{suffix}}`);\n      ",
        "lib/dependency.js": "import \"./owner.js\";",
