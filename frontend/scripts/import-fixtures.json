    "?sharedworker",
    "?worker&url",
    "?url&worker",
    "?rawness",
    "?url=value",
    "?raw#module",
    "?url#module",
    "?worker&url#module",
    "?raw&worker",
    "?%72aw",
    "?%75rl"
  ],
  "dataSuffixes": [
    "?raw",
    "?url",
    "?v=1&raw",
    "?url&v=1#module",
    "#?raw",
    "#?url",
    "?url&worker#module",
    "?raw&worker#module",
    "?url&%77orker"
  ],
  "escapeSuffixes": ["?v=1#module", "?worker", "?worker&url", "?raw#module", "?url#module", "?worker&url#module"],
  "viteCases": [
    ["?raw", false],
    ["?url", false],
    ["?raw#module", true],
    ["?url#module", true],
    ["#?raw", false],
    ["#?url", false],
    ["?worker", true],
    ["?worker&url", true],
    ["?url&worker", true],
    ["?worker&url#module", true],
    ["?url&worker#module", false],
    ["?raw&worker", true],
    ["?raw&worker#module", false],
    ["?sharedworker&url", true],
    ["?url&sharedworker#module", false],
    ["?%72aw", true],
    ["?%75rl", true],
    ["?url&%77orker", false]
  ],
  "viteBuild": {
    "configFile": false,
    "envFile": false,
    "logLevel": "silent",
    "worker": { "format": "es" },
    "build": { "write": false, "minify": false, "assetsInlineLimit": 0 }
  },
  "importPolicy": {
    "frontendArchitecture": { "testModuleMarkers": [".test.", ".spec."] },
    "sourceBudgets": [
      { "directory": "src", "extensions": [".js"], "classifier": "markers" },
      { "directory": "test", "extensions": [".js"], "classifier": "all" }
    ]
  },
  "frontendPolicy": {
    "frontendArchitecture": { "testModuleMarkers": [".test.", ".spec."] },
    "sourceBudgets": [{ "directory": "frontend/src", "extensions": [".js"], "classifier": "markers" }]
  },
  "sources": {
    "moduleSpecifiers": "\n    import value from \"./imported.js\";\n    export { value as renamed } from \"./named.js\";\n    export * from \"./all.js\";\n    const lazy = import(\"./lazy.js\");\n    const template = import(`./template.js`);\n    const ignored = import(variable);\n  ",
    "globSpecifiers": "\n    const modules = import.meta.glob(\"./*/index.ts\", { eager: true });\n    const metadata = import.meta.glob([\"./*/metadata.js\", \"./*/catalog.js\"]);\n    const ignored = import.meta.glob(variable);\n  ",
    "connectorBranches": "\n    const direct = connectorKind === \"redis\";\n    const active = connector.connector_kind;\n    const aliased = active === \"ssh\";\n    switch (connectorKind) { case \"postgres\": break; }\n    const connectorLabels = { kafka: \"Kafka\" };\n  ",
    "connectorMembership": "\n    const connectorKind = target.connector_kind;\n    const direct = [\"redis\", \"ssh\"].includes(connectorKind);\n    const lookup = new Set([\"postgres\", \"kafka\"]).has(connectorKind);\n  "
  },
  "cycleGraph": [
    ["a", ["b"]],
    ["b", ["c"]],
    ["c", ["a"]]
  ],
  "trees": {
    "profile-persistence": {
      "files": {
        "connectors/profile-lifecycle/persistence.js": "import \"../../lib/api.js\"; import \"../templates/fixture/model.js\";",
