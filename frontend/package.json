{
  "name": "aipermission-frontend",
  "version": "0.2.44",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "lint": "eslint .",
    "lint:suppressions": "eslint . --prune-suppressions",
    "test:architecture": "node --test scripts/architecture-graph.test.mjs src/lib/connector-registry-runtime.test.js src/lib/smoke/connector-templates.smoke.test.js && node scripts/architecture-budget.mjs",
    "test:duplication": "node scripts/duplication-budget.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:component",
    "test:unit": "node scripts/run-tests.mjs",
    "test:component": "vitest run --config vitest.config.js",
    "test:config": "node --test scripts/async-owner-manifest.test.mjs scripts/async-owner-policy.test.mjs scripts/no-skipped-playwright-reporter.test.mjs scripts/playwright-gate-policy.test.mjs && node scripts/test-suite-manifest.mjs",
    "test:async-race": "npm run test:config && node --test src/lib/request-guard.test.js src/components/app-shell-runtime.test.js && vitest run --config vitest.async.config.js",
    "test:coverage": "npm run test:config && npm run test:coverage:focused && npm run test:coverage:risk && npm run test:coverage:retry",
    "test:coverage:focused": "vitest run --config vitest.config.js --coverage",
    "test:coverage:risk": "vitest run --config vitest.risk.config.js --coverage",
    "test:coverage:retry": "node --test scripts/retry-coverage.test.mjs && node scripts/retry-coverage.mjs",
    "test:coverage:changed": "node --test scripts/coverage-config.test.mjs scripts/coverage-git-state.test.mjs scripts/coverage-owner-policy.test.mjs scripts/coverage-ratchet.test.mjs scripts/coverage-report-directory.test.mjs && node scripts/changed-coverage.mjs",
    "test:coverage:changed:update": "node scripts/changed-coverage.mjs --update-baseline",
    "test:e2e:policy": "node scripts/playwright-gate.mjs",
    "test:e2e": "npm run test:e2e:policy && playwright test",
    "test:e2e:smoke": "playwright test --grep-invert '@high-risk|@accessibility'",
    "test:e2e:accessibility": "playwright test --grep @accessibility",
    "test:e2e:high-risk": "npm run test:e2e:policy && playwright test --grep @high-risk",
    "test:e2e:real": "npm run test:e2e:policy && playwright test --config playwright.real.config.js",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.35.0",
    "monaco-editor": "^0.53.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "8.3.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-istanbul": "3.2.7",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^10.10.0",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "espree": "^11.2.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.11.0",
    "jscpd": "^5.1.2",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
