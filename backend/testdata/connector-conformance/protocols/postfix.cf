myhostname = protocols.fixture.test
myorigin = fixture.test
mydestination = fixture.test
alias_maps =
alias_database =
inet_interfaces = all
inet_protocols = ipv4
mynetworks = 127.0.0.0/8
smtpd_tls_cert_file = /run/protocols/tls.crt
smtpd_tls_key_file = /run/protocols/tls.key
smtpd_tls_security_level = encrypt
smtpd_tls_auth_only = yes
smtpd_sasl_type = dovecot
smtpd_sasl_path = private/auth
smtpd_sasl_auth_enable = yes
smtpd_sasl_security_options = noanonymous
smtpd_relay_restrictions = reject_unauth_destination
smtpd_recipient_restrictions = permit_sasl_authenticated, reject
local_transport = lmtp:unix:private/dovecot-lmtp
default_transport = error:fixture refuses external delivery
relay_transport = error:fixture refuses external relay
maillog_file = /dev/stdout
