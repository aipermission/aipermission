{
  "version": 1,
  "frontendArchitecture": {
    "sourceExtensions": [".js", ".jsx", ".mjs", ".cjs", ".ts", ".tsx"],
    "testModuleMarkers": [".test.", ".spec."],
    "maxDependencyFanout": 20,
    "maxProductionModuleLines": 550
  },
  "sourceBudgets": [
    {
      "id": "backend",
      "directory": "backend",
      "extensions": [".go"],
      "classifier": "go",
      "productionMaxLines": 1400,
      "testMaxLines": 1800,
      "testPackageMaxLines": 15000
    },
    {
      "id": "frontend",
      "directory": "frontend/src",
      "extensions": [".js", ".jsx", ".mjs", ".cjs", ".ts", ".tsx"],
      "classifier": "markers",
      "testPackageDepth": 3,
      "productionMaxLines": 550,
      "testMaxLines": 1000,
      "testPackageMaxLines": 3000
    },
    {
      "id": "frontend-e2e",
      "directory": "frontend/e2e",
      "extensions": [".js", ".jsx", ".mjs", ".cjs", ".ts", ".tsx"],
      "classifier": "all",
      "testPackageDepth": 0,
      "testMaxLines": 1000,
      "testPackageMaxLines": 1200
    },
    {
      "id": "frontend-e2e-real",
      "directory": "frontend/e2e-real",
      "extensions": [".js", ".jsx", ".mjs", ".cjs", ".ts", ".tsx"],
      "classifier": "all",
      "testPackageDepth": 0,
      "testMaxLines": 1000,
      "testPackageMaxLines": 1000
    },
    {
      "id": "frontend-public",
      "directory": "frontend/public",
      "extensions": [".js", ".mjs", ".cjs"],
      "classifier": "markers",
      "testPackageDepth": 0,
      "productionMaxLines": 550,
      "testMaxLines": 1000,
      "testPackageMaxLines": 1000
    },
    {
      "id": "mcp-source",
      "directory": "packages/mcp/src",
      "extensions": [".js", ".cjs", ".ts"],
      "classifier": "markers",
      "testPackageDepth": 1,
      "productionMaxLines": 800,
      "testMaxLines": 800,
      "testPackageMaxLines": 1200
    },
    {
      "id": "mcp-test",
      "directory": "packages/mcp/test",
      "extensions": [".js", ".cjs", ".ts"],
      "classifier": "all",
      "testPackageDepth": 1,
      "testMaxLines": 800,
      "testPackageMaxLines": 1200
    },
    {
      "id": "repository-tooling",
      "directory": "scripts",
      "extensions": [".js", ".mjs", ".cjs"],
      "classifier": "markers",
      "testPackageDepth": 1,
      "productionMaxLines": 550,
      "testMaxLines": 1000,
      "testPackageMaxLines": 900
    },
    {
      "id": "frontend-tooling",
      "directory": "frontend/scripts",
      "extensions": [".js", ".mjs", ".cjs"],
      "classifier": "markers",
      "testPackageDepth": 0,
      "productionMaxLines": 550,
      "testMaxLines": 1000,
      "testPackageMaxLines": 1000
    },
    {
      "id": "mcp-tooling",
      "directory": "packages/mcp/scripts",
      "extensions": [".js", ".mjs", ".cjs"],
      "classifier": "markers",
      "testPackageDepth": 0,
      "productionMaxLines": 550,
      "testMaxLines": 800,
      "testPackageMaxLines": 1200
    }
  ],
  "sourceBudgetMigrations": [
    {
      "budgetId": "repository-tooling",
      "fromTestPackageDepth": 0,
      "toTestPackageDepth": 1,
      "fromTestPackageMaxLines": 1500,
      "toTestPackageMaxLines": 900,
      "reason": "Separate repository tooling tests by top-level ownership while tightening the aggregate package cap."
    }
  ],
  "toolingTestRoots": [
    "scripts/ci",
    "scripts/maintenance",
    "scripts/release",
    "scripts/verification"
  ],
  "toolingTestFiles": [
    "scripts/ci/ci-workflow.test.js",
    "scripts/ci/compose-topology.test.js",
    "scripts/ci/documented-verification-contract.test.js",
    "scripts/ci/gitleaks-history-scan.test.js",
    "scripts/ci/markdown-link-check.test.js",
    "scripts/ci/platform/windows-runtime-tests.test.js",
    "scripts/ci/policy/verification-policy.test.js",
    "scripts/ci/run-bounded-fuzz.test.js",
    "scripts/maintenance/dependency-major-report.test.js",
    "scripts/maintenance/maintenance-budget-check.test.js",
    "scripts/maintenance/maintenance-budget-ratchet.test.js",
    "scripts/maintenance/maintenance-source-kind.test.js",
    "scripts/maintenance/run-tooling-tests.test.js",
    "scripts/maintenance/trusted-git-base.test.js",
    "scripts/release/images/publish-images-workflow.test.js",
    "scripts/release/release-notes.test.js",
    "scripts/release/release-version.test.js",
    "scripts/release/source/verify-release-source.test.js",
    "scripts/verification/verification-policy.test.js"
  ],
  "windowsRuntimeTests": [
    {
      "package": "github.com/aipermission/aipermission/backend/internal/db",
      "name": "TestDatabaseOwnershipIsExclusiveAndReleased"
    },
    {
      "package": "github.com/aipermission/aipermission/backend/internal/db",
      "name": "TestDatabaseOwnershipIsExclusiveAcrossProcesses"
    },
    {
      "package": "github.com/aipermission/aipermission/backend/internal/maintenanceconsole",
      "name": "TestMaintenanceConsoleUnsupportedRuntimeFailsClosed"
    },
    {
      "package": "github.com/aipermission/aipermission/backend/internal/maintenanceconsole",
      "name": "TestMaintenanceConsoleUnsupportedSupervisorFailsClosed"
    }
  ],
  "sourceOverrides": {},
  "backendCoverageDefaultFloor": 1.0,
  "backendCoverageExceptionBaseline": 1,
  "backendCoverageNeutralPackages": [
    "internal/auditedmutation",
    "internal/buildinfo",
    "internal/gatewayworkspace/runtimeinput",
    "internal/runtimeoutcome"
  ],
  "backendCoverageExcludedPackages": {
    "cmd/e2e": {
      "context": "linux-e2e",
      "reason": "Browser E2E fixture executable is tested by the real-backend Playwright gate."
    }
  },
  "backendCoveragePlatformFiles": {
    "internal/db/ownership_windows.go": {
      "platform": "windows",
      "buildConstraint": "windows",
      "minimumCoverage": 100.0,
      "tests": [
        {
          "package": "github.com/aipermission/aipermission/backend/internal/db",
          "name": "TestDatabaseOwnershipIsExclusiveAndReleased"
        },
        {
          "package": "github.com/aipermission/aipermission/backend/internal/db",
          "name": "TestDatabaseOwnershipIsExclusiveAcrossProcesses"
        }
      ]
    },
    "internal/maintenanceconsole/maintenance_console_process_unsupported.go": {
      "platform": "windows",
      "buildConstraint": "!linux",
      "minimumCoverage": 100.0,
      "tests": [
        {
          "package": "github.com/aipermission/aipermission/backend/internal/maintenanceconsole",
          "name": "TestMaintenanceConsoleUnsupportedRuntimeFailsClosed"
        }
      ]
    },
    "internal/maintenanceconsole/maintenance_console_supervisor_unsupported.go": {
      "platform": "windows",
      "buildConstraint": "!linux",
      "minimumCoverage": 100.0,
      "tests": [
        {
          "package": "github.com/aipermission/aipermission/backend/internal/maintenanceconsole",
          "name": "TestMaintenanceConsoleUnsupportedSupervisorFailsClosed"
        }
      ]
    }
  },
  "backendCoverageFloors": {
    "internal/accesscontrol": 69.0,
    "internal/api": 57.0,
    "internal/backups": 64.0,
    "internal/connectors/clickhouse": 58.0,
    "internal/connectors/docker": 52.0,
    "internal/connectors/kafka": 58.0,
    "internal/connectors/kubernetes": 42.0,
    "internal/connectors/mail": 53.0,
    "internal/connectors/postgres": 50.0,
    "internal/connectors/rabbitmq": 53.0,
    "internal/connectors/redis": 62.0,
    "internal/connectors/s3": 75.0,
    "internal/connectors/sqlsafe": 63.0,
    "internal/connectors/ssh": 76.0,
    "internal/connectormanagement": 73.0,
    "internal/connectorresources": 60.0,
    "internal/connectorruntime": 10.0,
    "internal/connectortargets": 63.0,
    "internal/console": 72.0,
    "internal/db": 75.0,
    "internal/filetransfer": 66.0,
    "internal/gatewayaccess": 60.0,
    "internal/gatewayaccess/httpowner": 21.0,
    "internal/gatewayconnectoractions": 6.0,
    "internal/gatewayconnectorapi": 55.0,
    "internal/gatewayconnectormanagement": 30.0,
    "internal/gatewayinfrastructure": 17.0,
    "internal/gatewayvault": 35.0,
    "internal/gatewayworkspace": 18.0,
    "internal/observability": 60.0,
    "internal/projectvault": 69.0,
    "internal/restcontract": 84.0,
    "internal/sessionenv": 64.0,
    "internal/tokens": 82.0,
    "internal/vault": 82.0,
    "internal/vaultrequests": 62.0,
    "internal/vaultsessions": 82.0
  },
  "connectorSourceMaxLines": 850,
  "backendPackage": {
    "defaultMaxLines": 3500,
    "stricterRatchets": {
      "backend/internal/db": 2700,
      "backend/internal/connectors/mail": 3200,
      "backend/internal/console": 3300,
      "backend/internal/connectors/s3": 3250
    }
  },
  "frontendSuppressions": {
    "maxCount": 0,
    "forbiddenPaths": [
      "src/components/console/connector-token-permission-panel.jsx",
      "src/components/console/vault-session-dialog.jsx",
      "src/pages/console.jsx",
      "src/pages/vault.jsx"
    ]
  },
  "goFunction": {
    "productionMaxLines": 180,
    "productionMaxComplexity": 35,
    "testMaxLines": 220,
    "testMaxComplexity": 60,
    "overrides": {}
  },
  "backendFanout": {
    "packageMax": 12,
    "ownerMax": 8,
    "familyOwnerMax": 25,
    "testPackageMax": 48,
    "testOwnerMax": 43,
    "testFamilyOwnerMax": 43,
    "testFileInternalImportsMax": 14,
    "testFileInternalOwnersMax": 14,
    "overrides": {}
  }
}
