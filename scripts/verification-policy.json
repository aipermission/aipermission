      },
      "reason": "Replace compile-only test binaries with native Windows ownership behavior execution."
    },
    {
      "name": "Backend Windows exact runtime evidence",
      "from": {
        "check": "Backend Windows Runtime",
        "command": "$env:CGO_ENABLED = \"0\"; go test -count=1 -v ./internal/db -run '^TestDatabaseOwnership'"
      },
      "to": {
        "check": "Backend Windows Runtime",
        "command": "node ../scripts/ci/windows-runtime-tests.js"
      },
      "reason": "Require exact pass evidence for every native Windows behavior instead of accepting an empty regex match."
    },
